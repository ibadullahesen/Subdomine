<!doctype html>
<html lang="az">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hissəcik Kürəsi</title>
<style>
  html,body{margin:0;height:100%;background:#04070e;overflow:hidden;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#9fb4c8}
  canvas{position:fixed;inset:0;width:100%;height:100%;display:block}
  #hud{position:fixed;left:0;right:0;bottom:28px;display:flex;flex-direction:column;align-items:center;gap:10px;pointer-events:none}
  #dot{width:14px;height:14px;border-radius:50%;box-sizing:border-box;border:2px solid #4cff7a;background:transparent;transition:background .12s,box-shadow .12s}
  #dot.on{background:#4cff7a;box-shadow:0 0 12px #4cff7a}
  #msg{font-size:12px;letter-spacing:.04em;opacity:.7;text-align:center;padding:0 16px}
  #cam{position:fixed;top:16px;left:16px;padding:10px 12px;display:flex;border-radius:8px;border:1px solid #2b4a63;background:#0a1624;color:#cfe6ff;font:inherit;font-size:13px;cursor:pointer}
  #cam:hover{background:#10243a}
  #cam[hidden]{display:none}
  video{position:fixed;width:1px;height:1px;opacity:0;pointer-events:none}
</style>
</head>
<body>
<canvas id="c"></canvas>
<video id="v" playsinline muted></video>
<button id="cam" aria-label="camera"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h4l2-3h6l2 3h4v11H3z"/><circle cx="12" cy="13" r="3.5"/></svg></button>
<div id="hud"><div id="dot"></div></div>

<script>
(() => {
  const cv = document.getElementById('c'), ctx = cv.getContext('2d');
  const dot = document.getElementById('dot'), msg = {};
  let W = 0, H = 0, DPR = 1, R = 100, F = 1000;

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight;
    cv.width = W * DPR; cv.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    R = Math.min(W, H) * 0.17;
    F = Math.min(W, H) * 1.3;
    ctx.fillStyle = '#04070e'; ctx.fillRect(0, 0, W, H);
  }
  addEventListener('resize', resize); resize();

  // ---------- hissəciklər ----------
  const N = 7000;
  const dx = new Float32Array(N), dy = new Float32Array(N), dz = new Float32Array(N);
  const rho = new Float32Array(N), shell = new Float32Array(N), spd = new Float32Array(N);
  const px = new Float32Array(N), py = new Float32Array(N);
  const col = new Uint8Array(N), wd = new Float32Array(N);
  for (let i = 0; i < N; i++) {
    const u = Math.random() * 2 - 1, a = Math.random() * Math.PI * 2, r = Math.sqrt(1 - u * u);
    dx[i] = r * Math.cos(a); dy[i] = r * Math.sin(a); dz[i] = u;
    shell[i] = 0.8 + Math.random() * 0.4;
    rho[i] = R * shell[i];
    spd[i] = 0.35 + Math.random() * 1.65;
    col[i] = Math.random() < 0.5 ? 0 : Math.random() < 0.6 ? 1 : Math.random() < 0.7 ? 2 : 3;
    wd[i] = 0.8 + Math.random() * 1.2;
    px[i] = -1;
  }
  const COLORS = ['rgba(62,224,208,0.6)', 'rgba(90,170,255,0.6)', 'rgba(40,100,255,0.6)', 'rgba(220,245,255,0.7)'];

  // ---------- durum ----------
  let target = 0;          // 0 = yığılıb, 1 = dağılıb
  let s = 0;               // hamarlaşdırılmış dəyər
  let cx = 0, cy = 0;      // kürənin mərkəz ofseti
  let tcx = 0, tcy = 0;
  let last = performance.now();
  let pointerDown = false, handActive = false;

  function frame(now) {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    const t = pointerDown ? 1 : (handActive ? target : 0);
    s += (t - s) * (1 - Math.exp(-dt * (t > s ? 9 : 6)));
    cx += (tcx - cx) * (1 - Math.exp(-dt * 6));
    cy += (tcy - cy) * (1 - Math.exp(-dt * 6));
    dot.classList.toggle('on', s > 0.5);

    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = 'rgba(4,7,14,' + (0.55 - 0.3 * s) + ')';
    ctx.fillRect(0, 0, W, H);

    const ox = W / 2 + cx, oy = H / 2 + cy;
    const maxRho = R * 9;
    const rot = dt * 0.35 * (1 - 0.8 * s), cr = Math.cos(rot), sr = Math.sin(rot);
    const base = R * 1.5;

    ctx.globalCompositeOperation = 'lighter';
    ctx.lineCap = 'round';

    const buckets = [[], [], [], []];
    for (let i = 0; i < N; i++) {
      // sferanı yavaş fırlat
      const x0 = dx[i], z0 = dz[i];
      dx[i] = x0 * cr + z0 * sr; dz[i] = -x0 * sr + z0 * cr;

      let r = rho[i];
      const home = R * shell[i];
      // geri çəkilmə (yığılma)
      r += (home - r) * Math.min(1, dt * 7) * (1 - s);
      // xaricə axın (dağılma)
      r += s * base * spd[i] * (1 + r / R * 0.35) * dt;
      if (s > 0.25 && (r > maxRho || dz[i] * r * 0.35 > F * 0.92)) { r = home; px[i] = -1; }
      rho[i] = r;

      const z = dz[i] * r * (0.35 + 0.65 * (1 - s));
      const k = F / (F - z);
      const X = ox + dx[i] * r * k, Y = oy + dy[i] * r * k;
      let x1 = px[i], y1 = py[i];
      if (x1 < 0) { x1 = X; y1 = Y; }
      px[i] = X; py[i] = Y;
      buckets[col[i]].push(x1, y1, X, Y, wd[i] * (0.7 + 0.5 * k));
    }
    for (let c = 0; c < 4; c++) {
      const b = buckets[c];
      ctx.strokeStyle = COLORS[c];
      // iki qalınlıq qrupu
      for (let pass = 0; pass < 2; pass++) {
        ctx.beginPath();
        for (let j = 0; j < b.length; j += 5) {
          if ((b[j + 4] > 1.3) !== (pass === 1)) continue;
          ctx.moveTo(b[j], b[j + 1]);
          ctx.lineTo(b[j + 2] + 0.01, b[j + 3]);
        }
        ctx.lineWidth = pass ? 1.7 : 1.0;
        ctx.stroke();
      }
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  // ---------- siçan / toxunuş ----------
  addEventListener('pointerdown', e => { if (e.target.id !== 'cam') pointerDown = true; });
  addEventListener('pointerup', () => pointerDown = false);
  addEventListener('pointercancel', () => pointerDown = false);
  addEventListener('keydown', e => { if (e.code === 'Space') pointerDown = true; });
  addEventListener('keyup', e => { if (e.code === 'Space') pointerDown = false; });

  // ---------- əl izləmə (MediaPipe Hands) ----------
  const camBtn = document.getElementById('cam'), video = document.getElementById('v');
  const BASE = 'https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/';
  const d2 = (a, b, asp) => Math.hypot((a.x - b.x) * asp, a.y - b.y);

  function openness(lm, asp) {
    const palm = d2(lm[0], lm[9], asp) || 1e-3;
    const tips = [4, 8, 12, 16, 20].map(i => lm[i]);
    const cxm = tips.reduce((a, p) => a + p.x, 0) / 5, cym = tips.reduce((a, p) => a + p.y, 0) / 5;
    let m = 0;
    for (const p of tips) m = Math.max(m, Math.hypot((p.x - cxm) * asp, p.y - cym));
    const v = m / palm;                       // birləşik ≈ 0.15, yumruq ≈ 0.5, bir barmaq ≥ 0.9
    return Math.min(1, Math.max(0, (v - 0.55) / 0.35));
  }

  function loadScript(src) {
    return new Promise((res, rej) => {
      const el = document.createElement('script');
      el.src = src; el.crossOrigin = 'anonymous';
      el.onload = res; el.onerror = () => rej(new Error('script'));
      document.head.appendChild(el);
    });
  }

  camBtn.addEventListener('click', async () => {
    camBtn.disabled = true; camBtn.style.opacity = .4;
    try {
      await loadScript(BASE + 'hands.js');
      const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480, facingMode: 'user' }, audio: false });
      video.srcObject = stream; await video.play();
      const hands = new Hands({ locateFile: f => BASE + f });
      hands.setOptions({ maxNumHands: 2, modelComplexity: 1, minDetectionConfidence: 0.6, minTrackingConfidence: 0.5 });
      hands.onResults(res => {
        const L = res.multiHandLandmarks || [];
        if (!L.length) { handActive = false; tcx = tcy = 0; return; }
        const asp = (video.videoWidth || 640) / (video.videoHeight || 480);
        let o = 0, mx = 0, my = 0;
        for (const lm of L) {
          o = Math.max(o, openness(lm, asp));
          mx += (1 - lm[9].x) / L.length; my += lm[9].y / L.length;
        }
        handActive = true; target = o;
        tcx = (mx - 0.5) * W * 0.35; tcy = (my - 0.5) * H * 0.35;
      });
      camBtn.hidden = true;
      
      const loop = async () => {
        if (video.readyState >= 2) { try { await hands.send({ image: video }); } catch (e) {} }
        requestAnimationFrame(loop);
      };
      loop();
    } catch (err) {
      camBtn.disabled = false; camBtn.style.opacity = 1;
      
    }
  });
})();
</script>
</body>
</html>
